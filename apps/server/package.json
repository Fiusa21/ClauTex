{
  "name": "@texcollab/server",
  "version": "0.1.0",
  "private": true,
  "description": "TexCollab local server: serves the web app, the project files API and compiles",
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts --dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.4",
    "@fastify/static": "10.1.6",
    "fastify": "5.12.7",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
